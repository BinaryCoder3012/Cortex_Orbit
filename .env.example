# Copy to .env and set ONE of the keys below. CortexOrbit picks the first one it
# finds (in this order), or the provider you name in AI_PROVIDER.
# With none set, it runs in offline mode: heuristic extraction, extractive
# answers and overlap-based grading.

# Anthropic Claude (best quality; paid)            https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini (free tier)                        https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free ":free" models available)       https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq (free tier, very fast)                      https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (free, runs on your machine, no key)      https://ollama.com
# Install it, run `ollama pull llama3.1`, then uncomment:
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434

# Optional
# AI_PROVIDER=gemini        # anthropic | gemini | openrouter | groq | ollama
# AI_MODEL=gemini-2.5-flash # override the provider's default model
# AI_BASE_URL=              # any other OpenAI-compatible endpoint
# CORTEX_OFFLINE=1          # force offline mode even with a key
# CORTEX_DATA_DIR=./data    # where cortex.db lives
# PORT=8787
